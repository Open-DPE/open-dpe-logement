{
  "name": "@open-dpe-logement/ademe-models",
  "version": "1.0.0",
  "description": "Modèles TypeScript pour les exports XML de l'observatoire DPE-Audit (ADEME)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "generate:enums": "node scripts/generate-enums.mjs",
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "dpe",
    "diagnostic",
    "energie",
    "3cl",
    "open-data",
    "ademe"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-dpe/open-dpe-logement"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@open-dpe-logement/ademe-fixtures": "^1.0.0",
    "@open-dpe-logement/ademe-parser": "^1.0.0",
    "@types/node": "^25.9.5",
    "vitest": "^4.1.6"
  }
}
