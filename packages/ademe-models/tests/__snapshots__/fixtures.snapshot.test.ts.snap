  "descriptif_geste_entretien_collection": [
    {
      "categorie_geste_entretien": "VMC",
      "description": "Ne pas obstruer les entrées d'air. Les nettoyer à l'aide d'un chiffon sec -> 1 fois par an 
 Nettoyer les bouches d'extraction -> tous les 2 ans
 Entretien des conduits par un professionnel -> tous les 3 à 5 ans 
 Veiller à ouvrir les fenêtres de chaque pièce très régulièrement afin de garantir la qualité de l'air intérieur",
      "enum_picto_geste_entretien_id": "1",
    },
    {
      "categorie_geste_entretien": "Chaudière",
      "description": "Entretien obligatoire par un professionnel -> 1 fois par an
 Programmer la température de chauffage en fonction de votre présence.
 Baisser la température la nuit. / Abaisser la température de 2 à 3°C la nuit.",
      "enum_picto_geste_entretien_id": "2",
    },
    {
      "categorie_geste_entretien": "Radiateurs",
      "description": "Dépoussiérer les radiateurs régulièrement.",
      "enum_picto_geste_entretien_id": "3",
    },
    {
      "categorie_geste_entretien": "Circuit de chauffage",
      "description": "Faire désembouer le circuit de chauffage par un professionnel -> tous les 10 ans
 Veiller au bon équilibrage de l'installation de chauffage.",
      "enum_picto_geste_entretien_id": "6",
    },
    {
      "categorie_geste_entretien": "Chauffe-eau",
      "description": "Régler la température du chauffe-eau entre 55 et 60°C.
 Arrêter le chauffe-eau en cas d'absence de plus de 4 jours.",
      "enum_picto_geste_entretien_id": "9",
    },
    {
      "categorie_geste_entretien": "Isolation",
      "description": "Faire vérifier et compléter les isolants par un professionnel -> tous les 20 ans.",
      "enum_picto_geste_entretien_id": "13",
