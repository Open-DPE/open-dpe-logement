{
	"name": "@open-dpe-logement/ademe-mapper",
	"version": "1.0.0",
	"description": "Conversion des données de l'observatoire DPE-Audit",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check-types": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"coverage": "npm run build && node scripts/coverage.mjs",
		"coverage:update": "npm run build && node scripts/coverage.mjs --update"
	},
	"keywords": [
		"dpe",
		"diagnostic",
		"energie",
		"3cl",
		"schema-to-schema"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/open-dpe/open-dpe-logement"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@open-dpe-logement/ademe-fixtures": "^1.0.0",
		"@open-dpe-logement/ademe-parser": "^1.0.0",
		"@open-dpe-logement/validator": "^1.0.0",
		"vitest": "^4.1.6"
	},
	"dependencies": {
		"@open-dpe-logement/ademe-models": "^1.0.0",
		"@open-dpe-logement/models": "^1.0.0",
		"uuid": "^14.0.1"
	}
}
