{
  "name": "@open-dpe-logement/abaques",
  "version": "1.0.0",
  "description": "Tables de référence (abaques) pour le calcul 3CL-DPE",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "imports": {
    "#loader.js": {
      "types": "./dist/loader.node.d.ts",
      "browser": {
        "development": "./src/loader.browser.ts",
        "default": "./dist/loader.browser.js"
      },
      "node": {
        "development": "./src/loader.node.ts",
        "default": "./dist/loader.node.js"
      },
      "default": "./dist/loader.node.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "prebuild": "npm run generate",
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "dpe",
    "diagnostic",
    "energie",
    "3cl",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-dpe/open-dpe-logement"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.3",
    "js-yaml": "^4.1.1",
    "vitest": "^4.1.6"
  }
}
